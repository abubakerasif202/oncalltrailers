# Copy to .env.local for local work. Never commit real values.
NEXT_PUBLIC_SITE_URL=https://www.oncalltrailers.com.au
# NEXT_PUBLIC_ALLOW_INDEXING=false

# Online booking widget. Unset or "off" disables the widget.
# "preview" renders the widget inside a click-blocking shield outside production.
# "live" requires the explicit owner approval flag below.
# NEXT_PUBLIC_LOCKII_MODE=preview
# Live needs both lines (production only opens with the approval flag):
# NEXT_PUBLIC_LOCKII_MODE=live
# NEXT_PUBLIC_LOCKII_OWNER_APPROVED=true
