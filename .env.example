# Copy to .env.local for local work. Never commit real values.
NEXT_PUBLIC_SITE_URL=https://www.oncalltrailers.com.au
# NEXT_PUBLIC_ALLOW_INDEXING=false

# Online booking widget. Leave unset (or "off") everywhere except a protected Preview environment.
# "preview" renders the widget inside a click-blocking shield; there is no live mode yet.
# A Vercel production environment always resolves to off, whatever this is set to.
# NEXT_PUBLIC_LOCKII_MODE=preview
# Live needs both lines (production only opens with the approval flag):
# NEXT_PUBLIC_LOCKII_MODE=live
# NEXT_PUBLIC_LOCKII_OWNER_APPROVED=true
